<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0.18"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bodybuilder_silhouette" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <LinearLayout
                android:id="@+id/chipAreaUpper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="82dp"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_chip_selector"
                android:tag="@string/body_area_upper"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:text="@string/body_area_upper" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAreaCore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="82dp"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_chip_selector"
                android:tag="@string/body_area_core"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:text="@string/body_area_core" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAreaLower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="82dp"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_chip_selector"
                android:tag="@string/body_area_lower"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:text="@string/body_area_lower" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/row2Upper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="6dp">

                    <com.example.aiapp.CheckableChip
                        android:id="@+id/chipMuscleAddUpper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_chip_add"
                        android:minWidth="82dp"
                        android:minHeight="34dp"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:text="+" />

                    </com.example.aiapp.CheckableChip>

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/row2Core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="6dp"
                android:visibility="gone">

                    <com.example.aiapp.CheckableChip
                        android:id="@+id/chipMuscleAddCore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_chip_add"
                        android:minWidth="82dp"
                        android:minHeight="34dp"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:text="+" />

                    </com.example.aiapp.CheckableChip>

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/row2Lower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="6dp"
                android:visibility="gone">

                    <com.example.aiapp.CheckableChip
                        android:id="@+id/chipMuscleAddLower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_chip_add"
                        android:minWidth="82dp"
                        android:minHeight="34dp"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:text="+" />

                    </com.example.aiapp.CheckableChip>

            </com.google.android.material.chip.ChipGroup>

        </FrameLayout>

        <TextView
            android:id="@+id/textMuscleExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_muscle_exercise_label"
            android:foreground="@drawable/bg_muscle_exercise_ripple"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Prsa - Bench press" />

        </LinearLayout>

            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/exerciseChipContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.example.aiapp.CheckableChip
                    android:id="@+id/chipExerciseAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_chip_add"
                    android:padding="4dp"
                    android:minHeight="26dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:text="+" />

                </com.example.aiapp.CheckableChip>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="start">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editWeightValue"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_frame"
                    android:padding="8dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textMaxWeight"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_max_weight_badge"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="80Max" />

            </LinearLayout>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:id="@+id/rowSets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/buttonRepDown"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_down" />

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:text="@string/label_rep" />

                        <TextView
                            android:id="@+id/textRepValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textColor="@color/dark_blue"
                            tools:text="5" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonRepUp"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_up" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/rowSets"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/buttonTimeDown"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_down" />

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:text="@string/label_time" />

                        <TextView
                            android:id="@+id/textTimeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textColor="@color/dark_blue"
                            tools:text="00:30" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonTimeUp"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_up" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/rowTime"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/buttonDelayDown"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_down" />

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:text="@string/label_delay" />

                        <TextView
                            android:id="@+id/textDelayValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textColor="@color/dark_blue"
                            tools:text="00:05" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonDelayUp"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:textSize="22sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"
                        android:text="@string/arrow_up" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupRepetitions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="@id/rowSets"
                app:layout_constraintStart_toEndOf="@id/rowDelay">

                <TextView
                    android:id="@+id/textRepetitionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stop_red"
                    android:textStyle="bold"
                    android:text="@string/label_repetitions" />

                <Button
                    android:id="@+id/buttonRepetitionsUp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:textSize="22sp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    android:text="@string/arrow_up" />

                <TextView
                    android:id="@+id/textRepetitionsValue"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textColor="@color/stop_red"
                    android:textStyle="bold"
                    tools:text="10" />

                <Button
                    android:id="@+id/buttonRepetitionsDown"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:textSize="22sp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    android:text="@string/arrow_down" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/textTrainingElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Čas tréninku: 5:23" />

        <LinearLayout
            android:id="@+id/groupStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:backgroundTint="@color/bg_button_start_tint"
                android:textColor="@color/white"
                android:text="@string/start" />

            <Button
                android:id="@+id/buttonSkipSet"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:backgroundTint="@color/bg_button_skip_tint"
                android:textColor="@color/white"
                android:enabled="false"
                android:text="@string/skip_set" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:backgroundTint="@color/bg_button_stop_tint"
                android:textColor="@color/white"
                android:enabled="false"
                android:text="@string/stop" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonEndWorkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/end_workout" />

    </LinearLayout>

    </ScrollView>

</FrameLayout>
